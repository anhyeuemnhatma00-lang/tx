local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local PlaceId = game.PlaceId
local CurrentJobId = game.JobId

-- Cấu hình
local MAX_PAGES = 5
local PAGE_LIMIT = 25
local PAGE_DELAY = 0.1
local MIN_SLOTS = 1

local function urlencode(str)
    return string.gsub(str, "([^%w%-_.~])", function(c)
        return string.format("%%%02X", string.byte(c))
    end)
end

local function tryHttpServers(cursor)
    local base = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=" .. tostring(PAGE_LIMIT)
    if cursor and cursor ~= "" then
        base = base .. "&cursor=" .. urlencode(cursor)
    end
    local ok, body = pcall(function() return game:HttpGet(base) end)
    if not ok or not body then return nil, nil end

    local success, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not success or not data then return nil, nil end
    return data.data or {}, data.nextPageCursor
end

local function findServerAndHop()
    local remote = ReplicatedStorage:FindFirstChild("__ServerBrowser")
    if remote and remote.ClassName == "RemoteFunction" then
        for p = 1, MAX_PAGES do
            local ok, pages = pcall(function() return remote:InvokeServer(p) end)
            if ok and type(pages) == "table" and #pages > 0 then
                for _, entry in ipairs(pages) do
                    local id = entry.id or entry.serverId
                    local playing = tonumber(entry.playing or entry.Players or entry.Count or 0) or 0
                    local maxPlayers = tonumber(entry.maxPlayers or entry.MaxPlayers or 0) or 0
                    if id and id ~= CurrentJobId and (maxPlayers - playing) >= MIN_SLOTS then
                        print("[AutoHop] Teleporting to server:", id)
                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(PlaceId, id, LocalPlayer)
                        end)
                        return true
                    end
                end
            end
            task.wait(PAGE_DELAY)
        end
    end

    local cursor = nil
    for i = 1, MAX_PAGES do
        local servers, nextCursor = tryHttpServers(cursor)
        if servers and #servers > 0 then
            for _, server in ipairs(servers) do
                local id = server.id
                local playing = tonumber(server.playing or 0)
                local maxPlayers = tonumber(server.maxPlayers or 0)
                if id and id ~= CurrentJobId and (maxPlayers - playing) >= MIN_SLOTS then
                    print("[AutoHop] Found server:", id, "Players:", playing, "/", maxPlayers)
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(PlaceId, id, LocalPlayer)
                    end)
                    return true
                end
            end
            cursor = nextCursor or nil
        else
            break
        end
        task.wait(PAGE_DELAY)
    end
    return false
end

task.spawn(function()
    local success = findServerAndHop()
    if not success then
        warn("[AutoHop] Không tìm thấy server phù hợp! Thử lại sau.")
    end
end)
