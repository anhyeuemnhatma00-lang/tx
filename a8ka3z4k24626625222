local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local rotateSpeed = 2000

spawn(function()
    while true do
        local character = player.Character or player.CharacterAdded:Wait()
        local root = character:FindFirstChild("HumanoidRootPart")
        if root and root.Parent then
            RunService.RenderStepped:Wait()
            local angle = math.rad(rotateSpeed * RunService.RenderStepped:Wait())
            root.CFrame = root.CFrame * CFrame.Angles(0, angle, 0)
        else
            wait(0.05)
        end
    end
end)

-- SCRIPT AUTO CHEST (NHẢY LIÊN TỤC KHI TWEEN)
local plr = game.Players.LocalPlayer
local TweenService = game:GetService("TweenService")

function setNoclip(state)
    local char = plr.Character
    if char then
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = not state
            end
        end
    end
end

function FindAllChests()
    local chests = {}
    for _, descendant in pairs(workspace.Map:GetDescendants()) do
        if descendant:IsA("Part") and (descendant.Name == "Chest1" or descendant.Name == "Chest2" or descendant.Name == "Chest3") then
            table.insert(chests, descendant)
        end
    end
    return chests
end

function FindNearestChestWithPriority(chestList, maxRadius)
    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local nearest, nearestDist = nil, math.huge
    local backup, backupDist = nil, math.huge
    for _, chest in pairs(chestList) do
        local d = (hrp.Position - chest.Position).Magnitude
        if d <= maxRadius and d < nearestDist then
            nearest = chest
            nearestDist = d
        elseif d < backupDist then
            backup = chest
            backupDist = d
        end
    end
    return nearest or backup
end

function TweenToChest(part, speed)
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if hrp and part and humanoid then
        setNoclip(true)
        local dist = (hrp.Position - part.Position).Magnitude
        local time = dist / speed
        local tween = TweenService:Create(
            hrp,
            TweenInfo.new(time, Enum.EasingStyle.Linear),
            {CFrame = CFrame.new(part.Position)}
        )
        tween:Play()
        -- Nhảy liên tục: ép Humanoid.Jump = true nhiều lần khi tween
        local jumping = true
        spawn(function()
            local t0 = tick()
            while jumping and tick() - t0 < time do
                humanoid.Jump = true
                wait(0.10)
            end
        end)
        tween.Completed:Wait()
        jumping = false
        setNoclip(false)
        return true
    end
    return false
end

function AutoChestPriorityLoop()
    local chestList = FindAllChests()
    while #chestList > 0 do
        local target = FindNearestChestWithPriority(chestList, 500)
        if not target then
            print("Không còn chest nào!")
            break
        end
        print("Tween tới chest:", target.Name)
        if TweenToChest(target, 270) then
            wait(0.2)
            firetouchinterest(target, plr.Character.HumanoidRootPart, 0)
            firetouchinterest(target, plr.Character.HumanoidRootPart, 1)
            print("Đã nhặt chest:", target.Name)
            wait(0.2)
        end
        for i, c in pairs(chestList) do
            if c == target then
                table.remove(chestList, i)
                break
            end
        end
    end
end

AutoChestPriorityLoop()
