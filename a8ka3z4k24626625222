local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local rotateSpeed = 3000

spawn(function()
    while true do
        local character = player.Character or player.CharacterAdded:Wait()
        local root = character:FindFirstChild("HumanoidRootPart")
        if root and root.Parent then
            RunService.RenderStepped:Wait()
            local angle = math.rad(rotateSpeed * RunService.RenderStepped:Wait())
            root.CFrame = root.CFrame * CFrame.Angles(0, angle, 0)
        else
            wait(0.05)
        end
    end
end)

-- SCRIPT AUTO CHEST
local plr = game.Players.LocalPlayer
local TweenService = game:GetService("TweenService")

function setNoclip(state)
    local char = plr.Character
    if char then
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = not state
            end
        end
    end
end

function FindAllChests()
    local chests = {}
    for _, descendant in pairs(workspace.Map:GetDescendants()) do
        if descendant:IsA("Part") and (descendant.Name == "Chest1" or descendant.Name == "Chest2" or descendant.Name == "Chest3") then
            table.insert(chests, descendant)
        end
    end
    return chests
end

function FindNearestChestWithPriority(chestList, maxRadius)
    local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local nearest, nearestDist = nil, math.huge
    local backup, backupDist = nil, math.huge
    for _, chest in pairs(chestList) do
        local d = (hrp.Position - chest.Position).Magnitude
        if d <= maxRadius and d < nearestDist then
            nearest = chest
            nearestDist = d
        elseif d < backupDist then
            backup = chest
            backupDist = d
        end
    end
    return nearest or backup
end

function CheckFistOfDarkness()
    return plr.Backpack:FindFirstChild("Fist of Darkness") ~= nil
end

function ActivateRaidSummon()
    local raidCD = game:GetService("Workspace").Map.CircleIsland.RaidSummon.Button.Main.ClickDetector
    if raidCD then
        fireclickdetector(raidCD)
        print("Đã kích hoạt RaidSummon!")
    end
end

function TweenToChest(part, speed)
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and part and humanoid) then return false end
    setNoclip(true)
    local dist = (hrp.Position - part.Position).Magnitude
    local time = dist / speed
    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(time, Enum.EasingStyle.Linear),
        {CFrame = CFrame.new(part.Position)}
    )
    local stopTween = false

    local jumping = true
    spawn(function()
        local t0 = tick()
        while jumping and tick() - t0 < time and not stopTween do
            humanoid.Jump = true
            wait(0.10)
        end
    end)

    -- Kiểm tra Fist of Darkness liên tục giữa lúc Tween
    spawn(function()
        while not stopTween do
            if CheckFistOfDarkness() then
                print("Phát hiện Fist of Darkness, dừng tween.")
                tween:Cancel()
                jumping = false
                setNoclip(false)
                ActivateRaidSummon()
                stopTween = true
                return
            end
            wait(0.1)
        end
    end)

    tween:Play()
    tween.Completed:Wait()
    jumping = false
    setNoclip(false)
    return not stopTween -- Trả về false nếu bị dừng tween giữa chừng
end

function AutoChestPriorityLoop()
    local chestList = FindAllChests()
    local foundFist = false
    while #chestList > 0 do
        if CheckFistOfDarkness() then
            foundFist = true
            print("Có Fist of Darkness, dừng loop!")
            break
        end
        local target = FindNearestChestWithPriority(chestList, 500)
        if not target then
            print("Không còn chest nào!")
            break
        end
        print("Tween tới chest:", target.Name)
        local tweenDone = TweenToChest(target, 270)
        if not tweenDone then
            foundFist = true
            print("Tween bị dừng do có Fist of Darkness!")
            break
        end
        wait(0.2)
        firetouchinterest(target, plr.Character.HumanoidRootPart, 0)
        firetouchinterest(target, plr.Character.HumanoidRootPart, 1)
        print("Đã nhặt chest:", target.Name)
        wait(0.2)
        for i, c in pairs(chestList) do
            if c == target then
                table.remove(chestList, i)
                break
            end
        end
    end
    if not foundFist then
        print("Nhặt hết chest mà vẫn không có Fist of Darkness, tiến hành AutoHop.")
        loadstring(game:HttpGet("https://raw.githubusercontent.com/anhyeuemnhatma00-lang/tx/refs/heads/main/popless"))()
    end
end

AutoChestPriorityLoop()
